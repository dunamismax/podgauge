# Safe local-development defaults only. Do not reuse these credentials in any
# shared, staging, or production environment. Production settings have no
# credential, origin, host, port, body-limit, or shutdown defaults.
NODE_ENV=development
DATABASE_URL=postgres://podgauge_web:podgauge_web_dev_only@127.0.0.1:54329/podgauge
ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=5173
BODY_SIZE_LIMIT=256K
SHUTDOWN_TIMEOUT=30
PODGAUGE_LOG_LEVEL=info
POSTGRES_DB=podgauge
POSTGRES_USER=podgauge
POSTGRES_PASSWORD=podgauge_dev_only

# POSTGRES_* belongs only to the development database container and creates its
# bootstrap administrator. Web, worker, migration, and backup processes use
# distinct logins. `pnpm db:roles` has safe local defaults for the administrator
# URL and the four local-only role passwords; production has no such defaults.
# PODGAUGE_ROLE_BOOTSTRAP_DATABASE_URL=postgres://admin:secret@postgres/podgauge
# PODGAUGE_MIGRATION_DATABASE_PASSWORD=
# PODGAUGE_WEB_DATABASE_PASSWORD=
# PODGAUGE_WORKER_DATABASE_PASSWORD=
# PODGAUGE_BACKUP_DATABASE_PASSWORD=

# Target-specific settings belong only in that process environment. The safe
# development defaults shown here are already enforced when these stay unset.
# PODGAUGE_WORKER_CONCURRENCY=1
# PODGAUGE_WORKER_JOB_TIMEOUT_SECONDS=300
# PODGAUGE_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
# PODGAUGE_MIGRATION_MAX_CONNECTIONS=1

# A target-specific DATABASE_URL must name its exact role. Keep these out of a
# web process environment; examples are shown only to document the boundary.
# DATABASE_URL=postgres://podgauge_migration:secret@postgres/podgauge
# DATABASE_URL=postgres://podgauge_worker:secret@postgres/podgauge
# DATABASE_URL=postgres://podgauge_backup:secret@postgres/podgauge

# Tests receive deterministic values from the committed Vitest and Playwright
# configs. Override only in an isolated test environment.
# NODE_ENV=test
# PODGAUGE_TEST_DATABASE_URL=postgres://podgauge:podgauge_dev_only@127.0.0.1:54329/podgauge
# PODGAUGE_TEST_SEED=podgauge-local-test-seed-v1
# PODGAUGE_RUN_DB_INTEGRATION=1

# Forwarded client-address trust remains intentionally unset until the owner
# selects and deploys a verified production network mode.
# ADDRESS_HEADER=
# XFF_DEPTH=
