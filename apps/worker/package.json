{
  "name": "@podgauge/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "smoke": "pnpm --filter @podgauge/observability build && tsx src/index.ts --smoke",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@podgauge/observability": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
