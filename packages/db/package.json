{
  "name": "@podgauge/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./roles": {
      "types": "./src/roles.ts",
      "default": "./dist/roles.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:roles": "pnpm --filter @podgauge/config build && tsx src/bootstrap-roles.ts",
    "db:generate": "pnpm --filter @podgauge/config build && drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm --filter @podgauge/config build && tsx src/migrate.ts",
    "db:seed": "pnpm --filter @podgauge/config build && tsx src/seed.ts"
  },
  "dependencies": {
    "@podgauge/config": "workspace:*",
    "@podgauge/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12"
  }
}
