{
  "$defs": {
    "__schema0": {
      "items": {
        "$ref": "#/$defs/__schema1"
      },
      "maxItems": 64,
      "minItems": 1,
      "readOnly": true,
      "type": "array"
    },
    "__schema1": {
      "pattern": "^evidence_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema2": {
      "pattern": "^finding_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema3": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ],
      "type": "string"
    },
    "__schema4": {
      "enum": [
        "input.malformed",
        "card.unresolved",
        "card.ambiguous",
        "card.classification-unknown",
        "deck.incomplete",
        "deck.duplicate-card",
        "deck.illegal-card",
        "deck.invalid-commander",
        "deck.color-identity-mismatch",
        "policy.rule-triggered",
        "policy.classification-unknown",
        "dependency.unsatisfied",
        "dependency.shared-failure-point",
        "methodology.unsupported",
        "simulation.unavailable",
        "evidence.coverage-insufficient"
      ],
      "type": "string"
    },
    "__schema5": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "__schema6": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cardId": {
              "pattern": "^card_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "kind": {
              "const": "card",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "cardId",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "faceId": {
              "pattern": "^face_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "kind": {
              "const": "card-face",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "faceId",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "deck-entry",
              "type": "string"
            },
            "parsedEntryId": {
              "pattern": "^entry_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "kind",
            "parsedEntryId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "policy-rule",
              "type": "string"
            },
            "ruleId": {
              "pattern": "^policy-rule_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "kind",
            "ruleId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dimension": {
              "enum": [
                "mana",
                "access",
                "cohesion",
                "control",
                "recovery",
                "conversion"
              ],
              "type": "string"
            },
            "kind": {
              "const": "deckprint-dimension",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "dimension",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "report",
              "type": "string"
            },
            "reportId": {
              "pattern": "^report_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "kind",
            "reportId"
          ],
          "type": "object"
        }
      ]
    },
    "__schema7": {
      "anyOf": [
        {
          "pattern": "^unknown_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "https://podgauge.com/schemas/Finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidenceIds": {
      "$ref": "#/$defs/__schema0"
    },
    "findingId": {
      "$ref": "#/$defs/__schema2"
    },
    "outcome": {
      "$ref": "#/$defs/__schema3"
    },
    "reasonCode": {
      "$ref": "#/$defs/__schema4"
    },
    "severity": {
      "$ref": "#/$defs/__schema5"
    },
    "subject": {
      "$ref": "#/$defs/__schema6"
    },
    "unknownClassificationId": {
      "$ref": "#/$defs/__schema7"
    }
  },
  "readOnly": true,
  "required": [
    "evidenceIds",
    "findingId",
    "outcome",
    "reasonCode",
    "severity",
    "subject",
    "unknownClassificationId"
  ],
  "title": "Finding",
  "type": "object"
}
