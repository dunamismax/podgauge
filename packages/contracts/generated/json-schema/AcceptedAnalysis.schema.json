{
  "$defs": {
    "__schema0": {
      "maxLength": 2048,
      "pattern": "^\\/api\\/v1\\/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$",
      "type": "string"
    }
  },
  "$id": "https://podgauge.com/schemas/AcceptedAnalysis.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysisId": {
      "pattern": "^analysis_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "eventsUrl": {
      "$ref": "#/$defs/__schema0"
    },
    "reportUrl": {
      "$ref": "#/$defs/__schema0"
    },
    "state": {
      "const": "queued",
      "type": "string"
    }
  },
  "readOnly": true,
  "required": [
    "analysisId",
    "eventsUrl",
    "reportUrl",
    "state"
  ],
  "title": "AcceptedAnalysis",
  "type": "object"
}
