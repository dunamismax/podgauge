{
  "$id": "https://podgauge.com/schemas/ParsedDeckEntry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collectorNumber": {
      "anyOf": [
        {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "entryId": {
      "pattern": "^entry_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "line": {
      "maximum": 2000,
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "quantity": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "section": {
      "enum": [
        "commander",
        "mainboard",
        "sideboard",
        "maybeboard",
        "background",
        "companion"
      ],
      "type": "string"
    },
    "setCode": {
      "anyOf": [
        {
          "pattern": "^[A-Z0-9]{2,8}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "readOnly": true,
  "required": [
    "collectorNumber",
    "entryId",
    "line",
    "name",
    "quantity",
    "section",
    "setCode"
  ],
  "title": "ParsedDeckEntry",
  "type": "object"
}
