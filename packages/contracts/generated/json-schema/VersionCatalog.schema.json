{
  "$defs": {
    "__schema0": {
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    }
  },
  "$id": "https://podgauge.com/schemas/VersionCatalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "additionalProperties": false,
          "properties": {
            "benchmarkVersionId": {
              "pattern": "^benchmark_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "readOnly": true,
          "required": [
            "benchmarkVersionId",
            "version"
          ],
          "type": "object"
        },
        "cardData": {
          "additionalProperties": false,
          "properties": {
            "snapshotId": {
              "pattern": "^card-data_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "readOnly": true,
          "required": [
            "snapshotId",
            "version"
          ],
          "type": "object"
        },
        "engine": {
          "additionalProperties": false,
          "properties": {
            "engineVersionId": {
              "pattern": "^engine_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "readOnly": true,
          "required": [
            "engineVersionId",
            "version"
          ],
          "type": "object"
        },
        "policy": {
          "additionalProperties": false,
          "properties": {
            "policyVersionId": {
              "pattern": "^policy_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "readOnly": true,
          "required": [
            "policyVersionId",
            "version"
          ],
          "type": "object"
        },
        "reportSchema": {
          "additionalProperties": false,
          "properties": {
            "reportSchemaVersionId": {
              "pattern": "^report-schema_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "readOnly": true,
          "required": [
            "reportSchemaVersionId",
            "version"
          ],
          "type": "object"
        },
        "simulation": {
          "additionalProperties": false,
          "properties": {
            "simulationVersionId": {
              "pattern": "^simulation_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "readOnly": true,
          "required": [
            "simulationVersionId",
            "version"
          ],
          "type": "object"
        }
      },
      "readOnly": true,
      "required": [
        "benchmark",
        "cardData",
        "engine",
        "policy",
        "reportSchema",
        "simulation"
      ],
      "type": "object"
    }
  },
  "readOnly": true,
  "required": [
    "active"
  ],
  "title": "VersionCatalog",
  "type": "object"
}
