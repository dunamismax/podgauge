{
  "$defs": {
    "__schema0": {
      "items": {
        "$ref": "#/$defs/__schema1"
      },
      "maxItems": 4,
      "minItems": 4,
      "readOnly": true,
      "type": "array"
    },
    "__schema1": {
      "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema2": {
      "pattern": "^pod_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema3": {
      "items": {
        "$ref": "#/$defs/__schema4"
      },
      "maxItems": 4,
      "readOnly": true,
      "type": "array"
    },
    "__schema4": {
      "pattern": "^report_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema5": {
      "enum": [
        "incomplete",
        "ready",
        "analyzing",
        "complete",
        "failed"
      ],
      "type": "string"
    }
  },
  "$id": "https://podgauge.com/schemas/PodResource.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deckRevisionIds": {
      "$ref": "#/$defs/__schema0"
    },
    "podId": {
      "$ref": "#/$defs/__schema2"
    },
    "reportIds": {
      "$ref": "#/$defs/__schema3"
    },
    "state": {
      "$ref": "#/$defs/__schema5"
    }
  },
  "readOnly": true,
  "required": [
    "deckRevisionIds",
    "podId",
    "reportIds",
    "state"
  ],
  "title": "PodResource",
  "type": "object"
}
