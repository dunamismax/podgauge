        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema7": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9-]+)+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
