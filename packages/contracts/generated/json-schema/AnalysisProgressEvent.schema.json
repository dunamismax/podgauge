      "type": "string"
    },
    "__schema3": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "__schema4": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    },
    "__schema5": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    },
    "__schema6": {
