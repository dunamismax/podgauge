{
  "$defs": {
    "__schema0": {
      "pattern": "^card_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema1": {
      "pattern": "^evidence_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://podgauge.com/schemas/UnknownClassification.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateCardIds": {
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "maxItems": 32,
      "readOnly": true,
      "type": "array"
    },
    "evidenceIds": {
      "items": {
        "$ref": "#/$defs/__schema1"
      },
      "maxItems": 64,
      "readOnly": true,
      "type": "array"
    },
    "reasonCode": {
      "enum": [
        "input.malformed",
        "card.unresolved",
        "card.ambiguous",
        "card.classification-unknown",
        "deck.incomplete",
        "deck.duplicate-card",
        "deck.illegal-card",
        "deck.invalid-commander",
        "deck.color-identity-mismatch",
        "policy.rule-triggered",
        "policy.classification-unknown",
        "dependency.unsatisfied",
        "dependency.shared-failure-point",
        "methodology.unsupported",
        "simulation.unavailable",
        "evidence.coverage-insufficient"
      ],
      "type": "string"
    },
    "state": {
      "const": "unknown",
      "type": "string"
    },
    "subject": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cardId": {
              "$ref": "#/$defs/__schema0"
            },
            "kind": {
              "const": "card",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "cardId",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "faceId": {
              "pattern": "^face_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "kind": {
              "const": "card-face",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "faceId",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "deck-entry",
              "type": "string"
            },
            "parsedEntryId": {
              "pattern": "^entry_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "kind",
            "parsedEntryId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "policy-rule",
              "type": "string"
            },
            "ruleId": {
              "pattern": "^policy-rule_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "kind",
            "ruleId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dimension": {
              "enum": [
                "mana",
                "access",
                "cohesion",
                "control",
                "recovery",
                "conversion"
              ],
              "type": "string"
            },
            "kind": {
              "const": "deckprint-dimension",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "dimension",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "report",
              "type": "string"
            },
            "reportId": {
              "pattern": "^report_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "readOnly": true,
          "required": [
            "kind",
            "reportId"
          ],
          "type": "object"
        }
      ]
    },
    "unknownClassificationId": {
      "pattern": "^unknown_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "readOnly": true,
  "required": [
    "candidateCardIds",
    "evidenceIds",
    "reasonCode",
    "state",
    "subject",
    "unknownClassificationId"
  ],
  "title": "UnknownClassification",
  "type": "object"
}
