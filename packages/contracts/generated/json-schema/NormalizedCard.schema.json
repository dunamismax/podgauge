{
  "$defs": {
    "__schema0": {
      "pattern": "^card_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "__schema1": {
      "items": {
        "$ref": "#/$defs/__schema2"
      },
      "maxItems": 5,
      "readOnly": true,
      "type": "array"
    },
    "__schema2": {
      "enum": [
        "W",
        "U",
        "B",
        "R",
        "G"
      ],
      "type": "string"
    },
    "__schema3": {
      "enum": [
        "eligible",
        "ineligible",
        "unknown"
      ],
      "type": "string"
    },
    "__schema4": {
      "items": {
        "$ref": "#/$defs/__schema5"
      },
      "maxItems": 8,
      "minItems": 1,
      "readOnly": true,
      "type": "array"
    },
    "__schema5": {
      "additionalProperties": false,
      "properties": {
        "cardId": {
          "$ref": "#/$defs/__schema0"
        },
        "colors": {
          "$ref": "#/$defs/__schema1"
        },
        "faceId": {
          "pattern": "^face_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "faceIndex": {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        "manaCost": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "oracleText": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "typeLine": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "readOnly": true,
      "required": [
        "cardId",
        "colors",
        "faceId",
        "faceIndex",
        "manaCost",
        "name",
        "oracleText",
        "typeLine"
      ],
      "type": "object"
    },
    "__schema6": {
      "enum": [
        "normal",
        "split",
        "transform",
        "modal-double-faced",
        "adventure",
        "meld",
        "other"
      ],
      "type": "string"
    }
  },
  "$id": "https://podgauge.com/schemas/NormalizedCard.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cardId": {
      "$ref": "#/$defs/__schema0"
    },
    "colorIdentity": {
      "$ref": "#/$defs/__schema1"
    },
    "commanderEligibility": {
      "$ref": "#/$defs/__schema3"
    },
    "faces": {
      "$ref": "#/$defs/__schema4"
    },
    "layout": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "readOnly": true,
  "required": [
    "cardId",
    "colorIdentity",
    "commanderEligibility",
    "faces",
    "layout"
  ],
  "title": "NormalizedCard",
  "type": "object"
}
